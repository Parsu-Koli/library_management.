<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%);
            --secondary-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 50%, #b45309 100%);
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.2);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: radial-gradient(circle at 20% 80%, rgba(16,185,129,0.3) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(245,158,11,0.3) 0%, transparent 50%), radial-gradient(circle at 40% 40%, rgba(5,150,105,0.1) 0%, transparent 50%), linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        .main-content {
            flex: 1;
            padding: 2rem;
            padding-bottom: 120px;
            position: relative;
        }

            .main-content > .container {
                background: var(--glass-bg);
                backdrop-filter: blur(20px);
                border-radius: 24px;
                border: 1px solid var(--glass-border);
                box-shadow: 0 25px 50px rgba(0,0,0,0.25);
                padding: 3rem;
                margin-top: 2rem;
            }

        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: var(--primary-gradient);
            backdrop-filter: blur(20px);
            border-top: 1px solid var(--glass-border);
            z-index: 1050;
            padding: 0.75rem 0;
            box-shadow: 0 -10px 30px rgba(0,0,0,0.3);
        }

        .nav-item {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 500;
            padding: 0.75rem 1rem;
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }

            .nav-item:hover,
            .nav-item.active {
                color: white !important;
                background: rgba(255,255,255,0.2);
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(16,185,129,0.4);
            }

            .nav-item i {
                font-size: 1.25rem;
                margin-bottom: 0.25rem;
                display: block;
            }

            .nav-item span {
                font-size: 0.75rem;
                display: block;
            }

        .library-logo {
            display: inline-flex;
            align-items: center;
        }

        .floating-books {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .book-float {
            position: absolute;
            font-size: 2rem;
            opacity: 0.1;
            animation: float 6s ease-in-out infinite;
        }

            .book-float:nth-child(1) {
                top: 20%;
                left: 10%;
                animation-delay: 0s;
                color: #10b981;
            }

            .book-float:nth-child(2) {
                top: 60%;
                right: 15%;
                animation-delay: 2s;
                color: #f59e0b;
            }

            .book-float:nth-child(3) {
                bottom: 30%;
                left: 20%;
                animation-delay: 4s;
                color: #3b82f6;
            }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-20px) rotate(5deg);
            }
        }

        @@keyframes glow {
            0%, 100% {
                box-shadow: 0 0 20px rgba(16,185,129,0.5);
            }

            50% {
                box-shadow: 0 0 40px rgba(16,185,129,0.8);
            }
        }

        .glow-effect {
            animation: glow 2s ease-in-out infinite;
        }

        @@media (max-width: 768px) {
            .main-content {
                padding: 1rem;
                padding-bottom: 100px;
            }

                .main-content > .container {
                    padding: 1.5rem;
                    margin-top: 1rem;
                    border-radius: 20px;
                }
        }
    </style>
</head>

<body>
    <div class="floating-books">
        <i class="bi bi-book-fill book-float glow-effect"></i>
        <i class="bi bi-book-fill book-float glow-effect"></i>
        <i class="bi bi-book-fill book-float glow-effect"></i>
    </div>

    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <nav class="bottom-nav">
        <div class="container">
            <div class="d-flex justify-content-around">
                <a class="nav-item active" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Home</span>
                </a>
                <a class="nav-item" asp-controller="Books" asp-action="Index">
                    <i class="bi bi-book-fill"></i>
                    <span>Books</span>
                </a>
                <a class="nav-item" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people-fill"></i>
                    <span>Users</span>
                </a>
                <a class="nav-item" asp-controller="Borrows" asp-action="Index">
                    <i class="bi bi-arrow-right-circle-fill"></i>
                    <span>Borrows</span>
                </a>
            </div>
        </div>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
