@model LibraryManagement.MVC.Models.BorrowViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <i class="bi bi-arrow-right-circle fs-1 mb-2"></i>
                    <h3>Borrow Record #@Model.Id</h3>
                </div>
                <div class="card-body p-5">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="info-card bg-light border-primary">
                                <div class="info-label"><i class="bi bi-book me-2"></i>Book</div>
                                <div class="info-value fw-bold fs-4">@Model.BookTitle (ID: @Model.BookId)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card bg-light border-success">
                                <div class="info-label"><i class="bi bi-person me-2"></i>User</div>
                                <div class="info-value fw-bold fs-4">@Model.UserName (ID: @Model.UserId)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card bg-light border-info">
                                <div class="info-label"><i class="bi bi-calendar-check me-2"></i>Borrow Date</div>
                                <div class="info-value">@Model.BorrowDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card bg-light @(Model.Status == "Active" ? "border-warning" : "border-success")">
                                <div class="info-label"><i class="bi bi-clock-history me-2"></i>Status</div>
                                <div class="info-value fs-5 fw-bold @(Model.Status == "Active" ? "text-warning" : "text-success")">
                                    @Model.Status
                                    @if (Model.ReturnDate.HasValue)
                                    {
                                        <br>
                                    
                                        <small>Returned: @Model.ReturnDate.Value.ToString("MMM dd, yyyy")</small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-center">
                        @if (Model.Status == "Active")
                        {
                            <form asp-action="Return" asp-route-id="@Model.Id" method="post"
                                  style="display:inline;" class="d-inline">
                                <button type="submit" class="btn btn-success btn-lg px-5 me-3"
                                        onclick="return confirm('Mark this book as returned?')">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Mark as Returned
                                </button>
                            </form>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">
                            <i class="bi bi-arrow-left me-2"></i>Back to Records
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
