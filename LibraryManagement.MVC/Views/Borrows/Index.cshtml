@model IEnumerable<LibraryManagement.MVC.Models.BorrowViewModel>

@{
    ViewData["Title"] = "Borrow Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-journal-arrow-down text-primary me-2"></i>Borrow Records
            </h2>
            <span class="text-muted">Track book issue and return activities</span>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Borrow Record
        </a>
    </div>

    <!-- Alerts -->
    @if (ViewBag.Error != null || TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @(ViewBag.Error ?? TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <div class="mb-3">
                <i class="bi bi-inboxes" style="font-size: 4.5rem; color:#adb5bd;"></i>
            </div>
            <h4 class="fw-semibold">No Borrow Records Found</h4>
            <p class="text-muted mb-4">You can create your first borrow transaction now.</p>

            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle me-1"></i> Create First Borrow
            </a>
        </div>
    }
    else
    {
        <!-- Data Table -->
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-list-task me-2"></i>
                    Borrow History
                </span>
                <span class="badge bg-light text-dark px-3 py-2">
                    Total: @Model.Count()
                </span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Book</th>
                                <th>User</th>
                                <th>Borrow Date</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var borrow in Model)
                            {
                                <tr class="@(borrow.Status == "Active" ? "table-warning" : "")">

                                    <td>
                                        <span class="badge bg-secondary">@borrow.Id</span>
                                    </td>

                                    <td>
                                        <strong>@borrow.BookTitle</strong><br />
                                        <small class="text-muted">ID: @borrow.BookId</small>
                                    </td>

                                    <td>
                                        <strong>@borrow.UserName</strong><br />
                                        <small class="text-muted">ID: @borrow.UserId</small>
                                    </td>

                                    <td>@borrow.BorrowDate.ToString("dd-MMM-yyyy")</td>

                                    <td>
                                        <span class="badge px-3 py-2
                                                    @(borrow.Status == "Active"
                                                                                              ? "bg-warning text-dark"
                                                                                              : "bg-success")">
                                    <i class="bi @(borrow.Status == "Active"
                                                                                       ? "bi-arrow-repeat"
                                                                                       : "bi-check-circle") me-1"></i>
                                    @borrow.Status
                                </span>
                            </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@borrow.Id"
                                           class="btn btn-outline-primary btn-sm me-1">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                @if (borrow.Status == "Active")
                                        {
                                            <form asp-action="Return"
                                                  asp-route-id="@borrow.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to return this book?');">

                                                <button type="submit"
                                                        class="btn btn-outline-success btn-sm">
                                                    <i class="bi bi-arrow-90deg-left"></i>
                                                </button>
                                            </form>
                                        }

                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    }
</div>
